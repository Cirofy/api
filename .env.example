# ─── Cirofy ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3001
# Geliştirme bayrağı — üretimde false bırakın
NEXT_PUBLIC_ALLOW_DEMO=false

# ─── PostgreSQL (primary OLTP + analytics-ready) ──────────────────────────────
POSTGRES_USER=cirofy
POSTGRES_PASSWORD=cirofy_dev_password
POSTGRES_DB=cirofy
# Host (local API): localhost:55432  |  Docker network: postgres:5432
DATABASE_URL=postgresql://cirofy:cirofy_dev_password@postgres:5432/cirofy?schema=public
DATABASE_URL_HOST=postgresql://cirofy:cirofy_dev_password@localhost:55432/cirofy?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
# Host’ta local API çalıştırıyorsan: redis://localhost:6380
# Docker compose içi API için: redis://redis:6379
REDIS_URL=redis://redis:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=cirofy-dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=cirofy-dev-refresh-secret-change-me-32chars
# Test/oturum: access 8h; yenileme 30g (POST /auth/refresh)
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=30d

# ─── Dodo Payments ────────────────────────────────────────────────────────────
# https://docs.dodopayments.com
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_STARTER=prod_starter_placeholder
DODO_PRODUCT_BUSINESS=prod_business_placeholder
DODO_PRODUCT_ENTERPRISE=prod_enterprise_placeholder
DODO_RETURN_URL=http://localhost:3001/billing/success

# ─── Marketplace APIs ─────────────────────────────────────────────────────────
# Eski bayrak — çekim her zaman canlı adaptörlerle yapılır (satıcı ID + anahtar gerekir).
# MARKETPLACE_LIVE_PULL=true
MARKETPLACE_HTTP_TIMEOUT_MS=20000
TRENDYOL_API_BASE=https://apigw.trendyol.com
# User-Agent: "{sellerId} - {TRENDYOL_INTEGRATOR_NAME}"
TRENDYOL_INTEGRATOR_NAME=SelfIntegration
HEPSIBURADA_API_BASE=https://mpop.hepsiburada.com
HEPSIBURADA_OMS_API_BASE=https://oms-external.hepsiburada.com
HEPSIBURADA_LISTING_API_BASE=https://listing-external.hepsiburada.com
HEPSIBURADA_FINANCE_API_BASE=https://mpfinance-external.hepsiburada.com
HEPSIBURADA_PROMO_API_BASE=https://diskonto-external.hepsiburada.com
HEPSIBURADA_PRODUCTS_PATH=/product/api/products/all-products-of-merchant
HEPSIBURADA_ORDERS_PATH=/orders/merchantId/{merchantId}
# HEPSIBURADA_USER_AGENT=cirofy_integration

# Reklam harcama çekimi (opsiyonel — kapalıyken boş liste)
ADS_LIVE_PULL=false
ADS_MARKETPLACE=TRENDYOL
# ADS_SAMPLE_JSON={"items":[{"sku":"SKU-1001","spend":100,"sales":800,"orders":3}]}
# ADS_PULL_URL=

# ─── Rapor e-postası (opsiyonel) ──────────────────────────────────────────────
# SMTP yokken gönderim kuyruğa yazılır, gerçek SMTP atlanır.
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_FROM=Cirofy <rapor@ornek.com>
